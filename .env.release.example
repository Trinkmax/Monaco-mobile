# .env.release.example — copiá este archivo a `.env.release` y completá.
#
#   cp .env.release.example .env.release
#
# `.env.release` está en .gitignore (nunca se commitea); este ejemplo SÍ va al
# repo, porque es la lista de qué necesita un build de tienda.
#
# Lo leen `scripts/build-release.sh` (los convierte en --dart-define) y
# `scripts/preflight-tiendas.sh` (chequea que estén). Formato KEY=VALOR, una por
# línea, sin comillas ni `export`. Una variable de entorno con el mismo nombre
# le gana al archivo.
#
# Una clave vacía o comentada NO se manda al build: la app usa el default de
# `lib/core/utils/constants.dart`, que apunta a producción.

# ── Ingreso con Google ──────────────────────────────────────────────────────
# Los dos salen de Google Cloud → APIs y servicios → Credenciales, del MISMO
# proyecto (ver ENTREGA.md §4-bis). Y los dos tienen que estar además en el
# secret GOOGLE_CLIENT_IDS de la edge function `client-auth`, o el server
# contesta SOCIAL_TOKEN_INVALID.
#
#   GOOGLE_IOS_CLIENT_ID    → client OAuth de tipo **iOS** (bundle
#                             com.monacobarber.monacoMobile). Su REVERSED_CLIENT_ID
#                             va además en CFBundleURLTypes del Info.plist.
#   GOOGLE_SERVER_CLIENT_ID → client OAuth de tipo **Web**. Sin él, el SDK de
#                             Android autentica pero NO emite id_token.
#
# Mientras estén vacíos, el botón de Google no se dibuja (a propósito).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# ── iOS ─────────────────────────────────────────────────────────────────────
# Team ID del Apple Developer Program (Membership details). Sólo se usa para
# generar ios/ExportOptions.plist la primera vez. Si la Mac tiene una sola
# cuenta de desarrollador, se puede dejar vacío.
APPLE_TEAM_ID=

# ── Modo prueba ─────────────────────────────────────────────────────────────
# Habilita el gesto de 7 toques sobre "Versión" en Perfil, que destapa la
# sucursal `test` (que es REAL y toma turnos). Vacío = el gesto no existe, que
# es lo correcto para el build que ve el reviewer de Apple.
TEST_MODE_CODE=

# ── Interruptores de emergencia ─────────────────────────────────────────────
# SOCIAL_LOGIN_ENABLED=false esconde Google Y Apple en la bienvenida. Es para
# el día en que `client-auth` no pueda validar los tokens: un botón que siempre
# contesta "no pudimos verificar tu cuenta" es rechazo por la 2.1.
SOCIAL_LOGIN_ENABLED=true

# LIQUID_GLASS=false apaga los shaders del dock y lo dibuja con el vidrio
# simple (BackdropFilter). Es para armarle un APK a un cliente cuyo equipo
# muestre artefactos o jank con `liquid_glass_renderer`, sin tocar código.
LIQUID_GLASS=true
