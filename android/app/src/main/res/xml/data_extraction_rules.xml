<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de extracción de datos (API 31+): nada va al backup en la nube y nada
  viaja en la transferencia directa entre equipos.

  Por qué: la sesión de Supabase y el device_secret viven en
  EncryptedSharedPreferences (flutter_secure_storage), cifrados con una clave
  del Android Keystore que es de ESTE equipo y no se exporta. En el teléfono
  nuevo esos archivos llegan indescifrables: el plugin tira al leerlos,
  `Supabase.initialize` no termina y la app se queda en el splash para siempre.
  Con android:allowBackup="false" solo no alcanza: desde Android 12, en varios
  fabricantes, ese atributo apaga el backup en la nube pero NO la transferencia
  entre equipos. Sin datos, el cliente vuelve a entrar con el código de WhatsApp
  o con Google/Apple, que es el comportamiento esperado (CLAUDE.md, riesgo 2).

  Se excluye TODO (no sólo sharedpref): el resto es cache y nada de eso vale
  más que arrancar limpio.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
